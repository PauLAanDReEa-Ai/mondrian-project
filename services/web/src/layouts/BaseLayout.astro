---
import "@mondrian/tokens";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  noindex?: boolean;
  bare?: boolean;
}

const { title, noindex = false, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = withBase("/", base);
const faviconHref = withBase("/favicon.svg", base);
const repoHref = "https://github.com/ruvebal/mondrian-project";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[bare && "bare"]}>
    {
      !bare && (
        <header class="site-header">
          <a class="brand" href={homeHref}>Liquid Mondrian</a>
          <a
            class="repo"
            href={repoHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Mondrian Project on GitHub"
          >
            <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              />
            </svg>
          </a>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    {
      !bare && (
        <footer>
          <p>Geometric studies after Mondrian · FE I / UDIT</p>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--mp-font-sans, "IBM Plex Sans", system-ui, sans-serif);
    background: var(--mp-color-canvas, #f4f2ed);
    color: var(--mp-color-ink, #121212);
  }
  body.bare {
    background: #0f172a;
    color: #f8fafc;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    max-width: 72rem;
    margin-inline: auto;
  }
  .site-header .brand {
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .site-header .repo {
    display: inline-flex;
    color: inherit;
    opacity: 0.85;
  }
  .site-header .repo:hover,
  .site-header .repo:focus-visible {
    opacity: 1;
  }
  footer,
  main:not(:has(.landing)) {
    padding: 1rem 1.25rem;
    max-width: 42rem;
    margin-inline: auto;
  }
  footer {
    color: var(--mp-color-muted, #5c5c5c);
    font-size: var(--mp-text-sm, 0.875rem);
  }
  a {
    color: inherit;
  }
</style>
