---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";

const base = import.meta.env.BASE_URL;
const contribute = withBase("/contribute/", base);
const heroBg = withBase("/brand/hero-bg.svg", base);
const wordmark = withBase("/brand/wordmark.svg", base);
const mark = withBase("/brand/mark.svg", base);
const repoHref = "https://github.com/ruvebal/mondrian-project";
const liveHref = "https://ruvebal.github.io/mondrian-project/";
---
<BaseLayout title="Liquid Mondrian" bare>
  <section class="landing" style={`--hero-bg: url('${heroBg}')`}>
    <header class="landing__chrome">
      <a class="landing__home" href={withBase("/", base)} aria-label="Liquid Mondrian home">
        <img class="landing__mark" src={mark} width="40" height="40" alt="" />
        <span>Liquid Mondrian</span>
      </a>
      <a
        class="landing__repo"
        href={repoHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Mondrian Project repository on GitHub"
      >
        <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
          />
        </svg>
      </a>
    </header>

    <div class="landing__stage">
      <div class="landing__copy">
        <img
          class="landing__wordmark"
          src={wordmark}
          width="420"
          height="120"
          alt="Liquid Mondrian"
        />
        <h1 class="landing__title">Liquid Mondrian</h1>
        <blockquote class="landing__flag">
          <p>
            La Plastique nouvelle met ses rapports en équilibre esthétique et
            exprime par là l'harmonie nouvelle.
          </p>
          <footer>
            <cite>
              <i>Le Néoplasticisme</i>. Paris: Éditions de l'Effort Moderne
              (Léonce Rosenberg), 1920.
            </cite>
          </footer>
        </blockquote>
        <p class="landing__lede">
          Measure neoplastic compositions, liquid-fill a free-aspect frame, and
          take a personal version — URL, print, or file.
        </p>
        <p class="landing__cta">
          <a class="btn btn--primary" href={contribute}>How to contribute</a>
          <a class="btn btn--ghost" href={repoHref} target="_blank" rel="noopener noreferrer">
            Repository
          </a>
        </p>
        <p class="landing__live">
          Live:
          <a href={liveHref}>{liveHref.replace(/^https:\/\//, "")}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .landing {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    background-color: #0f172a;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center right;
    color: #f8fafc;
  }

  .landing__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    max-width: 72rem;
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .landing__home {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .landing__mark {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, #f8fafc 25%, transparent);
  }

  .landing__repo {
    display: inline-flex;
    color: #f8fafc;
    opacity: 0.9;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .landing__repo:hover,
  .landing__repo:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
  }

  .landing__stage {
    display: flex;
    align-items: center;
    padding: 1.5rem 1.25rem 3rem;
    max-width: 72rem;
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .landing__copy {
    max-width: min(34rem, 92vw);
  }

  .landing__wordmark {
    display: block;
    width: min(22rem, 88vw);
    height: auto;
    margin-bottom: 0.75rem;
  }

  .landing__title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .landing__flag {
    margin: 1.25rem 0 1rem;
    padding: 0;
    border: 0;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    line-height: 1.45;
    font-style: italic;
    font-weight: 400;
  }

  .landing__flag p {
    margin: 0 0 0.75rem;
  }

  .landing__flag footer {
    margin: 0;
    padding: 0;
    max-width: none;
    font-size: 0.8rem;
    font-style: normal;
    opacity: 0.75;
    line-height: 1.4;
  }

  .landing__flag cite {
    font-style: normal;
  }

  .landing__lede {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    line-height: 1.5;
    opacity: 0.92;
    max-width: 28rem;
  }

  .landing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid #f8fafc;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .btn--primary {
    background: #f8fafc;
    color: #0f172a;
  }

  .btn--ghost {
    background: transparent;
    color: #f8fafc;
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translateY(-1px);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    background: #e2e8f0;
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: color-mix(in srgb, #f8fafc 12%, transparent);
  }

  .landing__live {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .landing__live a {
    text-underline-offset: 0.15em;
  }

  @media (max-width: 720px) {
    .landing {
      background-position: 70% center;
    }

    .landing__copy {
      background: color-mix(in srgb, #0f172a 72%, transparent);
      padding: 1rem;
      margin-inline: -0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing__repo,
    .btn {
      transition: none;
    }
  }
</style>
