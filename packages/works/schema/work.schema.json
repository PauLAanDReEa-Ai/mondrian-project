{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mondrian-project.local/schemas/work.schema.json",
  "title": "MondrianWork",
  "description": "Immutable measured neo-plastic composition. Geometry adapts Andrzejewski et al. 2010 §3.2 (grid points, rectangles, explicit lines) — not the paper's classifier or generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "year",
    "source",
    "canvas",
    "geometry",
    "provenance",
    "rights",
    "swatches"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 1000, "maximum": 2100 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "inventory"],
      "properties": {
        "collection": { "type": "string" },
        "inventory": { "type": "string" },
        "catalogueNote": { "type": "string" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSpace", "points", "rectangles", "lines"],
      "properties": {
        "coordinateSpace": {
          "type": "string",
          "const": "normalized-0-1"
        },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/axisPoint" }
            },
            "y": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/axisPoint" }
            }
          }
        },
        "rectangles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rectangle" }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reproduction", "review"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["hand", "analyzer", "external"]
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "px_w", "px_h", "crop"],
          "properties": {
            "source": { "type": "string" },
            "px_w": { "type": "integer", "exclusiveMinimum": 0 },
            "px_h": { "type": "integer", "exclusiveMinimum": 0 },
            "crop": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x0", "y0", "x1", "y1"],
              "properties": {
                "x0": { "type": "number", "minimum": 0 },
                "y0": { "type": "number", "minimum": 0 },
                "x1": { "type": "number", "exclusiveMinimum": 0 },
                "y1": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["proposal", "accepted"] },
            "reviewed_by": { "type": "string" },
            "date": { "type": "string", "format": "date" }
          }
        },
        "measured_by": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "analyzer_version": { "type": "string" },
        "run_at": { "type": "string" },
        "dataset": { "type": "string" },
        "citation": { "type": "string" },
        "record_id": { "type": "string" },
        "license": { "type": "string" },
        "imported_by": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "hand" } },
            "required": ["method"]
          },
          "then": { "required": ["measured_by", "date"] }
        },
        {
          "if": {
            "properties": { "method": { "const": "analyzer" } },
            "required": ["method"]
          },
          "then": { "required": ["analyzer_version", "run_at"] }
        },
        {
          "if": {
            "properties": { "method": { "const": "external" } },
            "required": ["method"]
          },
          "then": {
            "required": [
              "dataset",
              "citation",
              "record_id",
              "license",
              "imported_by",
              "date"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "review": {
                "properties": { "status": { "const": "accepted" } },
                "required": ["status"]
              }
            },
            "required": ["review"]
          },
          "then": {
            "properties": {
              "review": { "required": ["status", "reviewed_by", "date"] }
            }
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eu", "us", "checked_by", "date"],
      "properties": {
        "eu": { "type": "string" },
        "us": { "type": "string" },
        "checked_by": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "credit": { "type": "string" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": true
    },
    "swatches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "red": { "$ref": "#/$defs/swatch" },
        "yellow": { "$ref": "#/$defs/swatch" },
        "blue": { "$ref": "#/$defs/swatch" },
        "black": { "$ref": "#/$defs/swatch" },
        "white": { "$ref": "#/$defs/swatch" },
        "gray": { "$ref": "#/$defs/swatch" }
      }
    }
  },
  "$defs": {
    "axisPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "role"],
      "properties": {
        "id": { "type": "string" },
        "x": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "y": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "role": {
          "type": "string",
          "enum": ["red", "yellow", "blue", "black", "white", "gray"]
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "orientation", "center", "extent", "thickness"],
      "properties": {
        "id": { "type": "string" },
        "orientation": { "type": "string", "enum": ["h", "v"] },
        "center": { "type": "string" },
        "extent": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "thickness": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 }
      }
    },
    "swatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured"],
      "properties": {
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h", "s", "l"],
          "properties": {
            "h": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
            "s": { "type": "number", "minimum": 0, "maximum": 100 },
            "l": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  }
}
